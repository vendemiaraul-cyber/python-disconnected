/* MiniTok dark theme - TikTok-ish: black, white text, red/cyan accents */
QMainWindow, QWidget#Root { background: #000000; }
QWidget { color: #ffffff; font-size: 13px; }

QGraphicsView#Player { background: #000000; border: none; }

QLabel#TabInactive { color: rgba(255,255,255,0.6); font-size: 15px; font-weight: 600; }
QLabel#TabActive { color: #ffffff; font-size: 15px; font-weight: 700;
                   border-bottom: 2px solid #ffffff; padding-bottom: 3px; }

QToolButton#Gear { background: transparent; border: none; color: #ffffff; font-size: 22px;
                   min-width: 32px; min-height: 32px; }
QToolButton#Gear:hover { color: #d0d0d0; }

QLabel#Author { color: #ffffff; font-size: 15px; font-weight: 700; }
QLabel#Caption { color: #ffffff; font-size: 13px; }
QLabel#Music { color: #ffffff; font-size: 12px; }
QLabel#Status { color: #ffffff; font-size: 15px; background: rgba(0,0,0,0.55);
                border-radius: 10px; padding: 14px; }
QLabel#BigIcon { color: rgba(255,255,255,0.85); font-size: 64px; background: transparent; }

QProgressBar#Progress { background: rgba(255,255,255,0.25); border: none; max-height: 2px; }
QProgressBar#Progress::chunk { background: #ffffff; }

/* comments bottom sheet (light, like the real app) */
QFrame#Sheet { background: #ffffff; border-top-left-radius: 14px; border-top-right-radius: 14px; }
QFrame#Sheet QLabel { color: #161823; }
QFrame#Sheet QLabel#SheetTitle { font-weight: 700; font-size: 13px; }
QFrame#Sheet QLabel#SheetNote { color: #8a8b91; font-size: 11px; }
QFrame#Sheet QLabel#CAuthor { color: #8a8b91; font-size: 12px; font-weight: 600; }
QFrame#Sheet QLabel#CText { color: #161823; font-size: 13px; }
QFrame#Sheet QLabel#CMeta { color: #8a8b91; font-size: 11px; }
QFrame#Sheet QLabel#CAvatar { background: #e3e3e4; color: #161823; border-radius: 16px;
                              font-weight: 700; }
QFrame#Sheet QScrollArea, QFrame#Sheet QWidget#CommentList { background: #ffffff; border: none; }
QFrame#Sheet QToolButton { background: transparent; border: none; color: #161823; font-size: 16px; padding: 4px; }
QFrame#Sheet QPushButton#Export { background: #fe2c55; color: #ffffff; border: none; border-radius: 4px;
                                  padding: 5px 12px; font-weight: 600; }
QFrame#Sheet QPushButton#Export::menu-indicator { width: 0px; }
QFrame#Sheet QScrollBar:vertical { background: #ffffff; width: 6px; }
QFrame#Sheet QScrollBar::handle:vertical { background: #d0d0d3; border-radius: 3px; }

/* settings dialog */
QDialog, QDialog QScrollArea > QWidget > QWidget, QDialog QTabWidget > QWidget { background: #121212; }
QGroupBox { background: #181818; border: 1px solid #2a2a2a; border-radius: 6px; margin-top: 16px;
            padding: 10px 6px 6px 6px; color: #ffffff; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #ffffff; }
QGroupBox QLabel, QGroupBox QCheckBox { background: transparent; font-weight: 400; }
QDialog QLabel { color: #e8e8e8; }
QDialog QLabel#Hint { color: #9a9a9a; font-size: 11px; }
QDialog QLabel#H { font-size: 14px; font-weight: 700; color: #ffffff; }
QTabWidget::pane { border: 1px solid #2a2a2a; border-radius: 6px; top: -1px; }
QTabBar::tab { background: #1e1e1e; color: #bbbbbb; padding: 7px 12px; border-top-left-radius: 6px;
               border-top-right-radius: 6px; margin-right: 2px; }
QTabBar::tab:selected { background: #2b2b2b; color: #ffffff; }
QPushButton { background: #2b2b2b; border: 1px solid #3a3a3a; border-radius: 6px; padding: 6px 12px; color: #ffffff; }
QPushButton:hover { background: #363636; }
QPushButton#Primary { background: #fe2c55; border: none; font-weight: 700; }
QPushButton#Primary:hover { background: #ff4a6e; }
QPushButton:disabled { color: #666666; }
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTableWidget {
    background: #1c1c1c; border: 1px solid #333333; border-radius: 5px; color: #f0f0f0; padding: 3px;
    selection-background-color: #fe2c55; }
QComboBox QAbstractItemView { background: #1c1c1c; color: #f0f0f0; selection-background-color: #fe2c55; }
QHeaderView::section { background: #232323; color: #cccccc; border: none; padding: 4px; }
QSlider::groove:horizontal { height: 4px; background: #3a3a3a; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #25f4ee; border-radius: 2px; }
QSlider::handle:horizontal { background: #ffffff; width: 14px; margin: -6px 0; border-radius: 7px; }
QCheckBox { color: #e8e8e8; }
QProgressBar { background: #1c1c1c; border: 1px solid #333; border-radius: 4px; text-align: center; color: #fff; }
QProgressBar::chunk { background: #fe2c55; border-radius: 4px; }
QScrollArea { border: none; background: transparent; }
QMenu { background: #ffffff; color: #161823; border: 1px solid #ddd; }
QMenu::item { padding: 6px 18px; }
QMenu::item:selected { background: #f1f1f2; }
QToolTip { background: #222; color: #fff; border: 1px solid #444; }
